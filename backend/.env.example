# Copy to backend/.env. Every setting is in app/config.py.
AGENTTOWN_DATABASE_URL=sqlite:///./agenttown.db
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENTTOWN_SECRET_KEY=change-me
AGENTTOWN_COOKIE_SECURE=false
# true only for local development (lets the API check MCP servers on localhost)
AGENTTOWN_ALLOW_PRIVATE_MCP_HOSTS=true
# Lets users store Claude/ChatGPT subscription tokens as well as API keys
AGENTTOWN_ALLOW_SUBSCRIPTION_TOKENS=true
# Where agents run: local (a subprocess here, dev only, not isolated) | modal
AGENTTOWN_SANDBOX_PROVIDER=local
# How a sandbox reaches this API (in production: the public https URL)
AGENTTOWN_PUBLIC_URL=http://127.0.0.1:8000
